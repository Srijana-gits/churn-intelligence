# Environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Data — never commit data files.
# The raw dataset is public and documented in the README; processed files
# are rebuilt by running the cleaning script.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Databases built from the data
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store

# Trained models — rebuilt by src/train_model.py
models/
