            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[priority_list].[none:bucket:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[priority_list].[none:bucket:nk]</rows>
        <cols>[priority_list].[sum:monthly_bill_at_risk:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Risk and monthly bill">
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize="12" fontcolor="#162b40" bold="true">Risk and monthly bill</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="priority_list" caption="Eligible current customers • retrospective OOF scores" />
          </datasources>
          <datasource-dependencies datasource="priority_list">
            <column datatype="real" name="[MonthlyCharges]" role="measure" type="quantitative" caption="Monthly bill ($)" default-format="n#,##0.00" />
            <column datatype="real" name="[churn_probability]" role="measure" type="quantitative" caption="Churn score" default-format="p0.0%" />
            <column datatype="string" name="[bucket]" role="dimension" type="nominal" caption="Priority bucket" />
            <column datatype="string" name="[customerID]" role="dimension" type="nominal" caption="Customer ID" />
            <column-instance column="[MonthlyCharges]" derivation="Avg" name="[avg:MonthlyCharges:qk]" pivot="key" type="quantitative" />
            <column-instance column="[churn_probability]" derivation="Avg" name="[avg:churn_probability:qk]" pivot="key" type="quantitative" />
            <column-instance column="[bucket]" derivation="None" name="[none:bucket:nk]" pivot="key" type="nominal" />
            <column-instance column="[customerID]" derivation="None" name="[none:customerID:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="font-size" value="10" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Circle" />
            <encodings>
              <color column="[priority_list].[none:bucket:nk]" />
              <lod column="[priority_list].[none:customerID:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[priority_list].[avg:MonthlyCharges:qk]</rows>
        <cols>[priority_list].[avg:churn_probability:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Ranked contact table">
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize="12" fontcolor="#162b40" bold="true">Ranked contact table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="priority_list" caption="Eligible current customers • retrospective OOF scores" />
          </datasources>
          <datasource-dependencies datasource="priority_list">
            <column datatype="integer" name="[priority_rank]" role="dimension" type="nominal" caption="Rank" default-format="n#,##0" />
            <column datatype="string" name="[customerID]" role="dimension" type="nominal" caption="Customer ID" />
            <column datatype="string" name="[bucket]" role="dimension" type="nominal" caption="Priority bucket" />
            <column datatype="string" name="[Contract]" role="dimension" type="nominal" caption="Contract" />
            <column datatype="string" name="[InternetService]" role="dimension" type="nominal" caption="Internet service" />
            <column datatype="real" name="[churn_probability]" role="measure" type="quantitative" caption="Churn score" default-format="p0.0%" />
            <column datatype="real" name="[MonthlyCharges]" role="measure" type="quantitative" caption="Monthly bill ($)" default-format="n#,##0.00" />
            <column datatype="real" name="[monthly_bill_at_risk]" role="measure" type="quantitative" caption="Score × monthly bill (ranking measure)" default-format="n#,##0.00" />
            <column-instance column="[priority_rank]" derivation="None" name="[none:priority_rank:ok]" pivot="key" type="ordinal" />
            <column-instance column="[customerID]" derivation="None" name="[none:customerID:nk]" pivot="key" type="nominal" />
            <column-instance column="[bucket]" derivation="None" name="[none:bucket:nk]" pivot="key" type="nominal" />
            <column-instance column="[Contract]" derivation="None" name="[none:Contract:nk]" pivot="key" type="nominal" />
            <column-instance column="[InternetService]" derivation="None" name="[none:InternetService:nk]" pivot="key" type="nominal" />
            <column-instance column="[churn_probability]" derivation="Avg" name="[avg:churn_probability:ok]" pivot="key" type="ordinal" />
            <column-instance column="[MonthlyCharges]" derivation="Avg" name="[avg:MonthlyCharges:ok]" pivot="key" type="ordinal" />
            <column-instance column="[monthly_bill_at_risk]" derivation="Avg" name="[avg:monthly_bill_at_risk:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[priority_list].[none:bucket:nk]">
            <groupfilter function="level-members" level="[none:bucket:nk]" />
          </filter>
          <filter class="categorical" column="[priority_list].[none:Contract:nk]">
            <groupfilter function="level-members" level="[none:Contract:nk]" />
          </filter>
          <filter class="categorical" column="[priority_list].[none:InternetService:nk]">
            <groupfilter function="level-members" level="[none:InternetService:nk]" />
          </filter>
          <slices>
            <column>[priority_list].[none:bucket:nk]</column>
            <column>[priority_list].[none:Contract:nk]</column>
            <column>[priority_list].[none:InternetService:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="font-size" value="10" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[priority_list].[avg:monthly_bill_at_risk:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#162b40" />
                <format attr="font-size" value="10" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([priority_list].[none:priority_rank:ok] / [priority_list].[none:customerID:nk] / [priority_list].[none:bucket:nk] / [priority_list].[none:Contract:nk] / [priority_list].[none:InternetService:nk] / [priority_list].[avg:churn_probability:ok] / [priority_list].[avg:MonthlyCharges:ok])</rows>
        <cols />
      </table>
    </worksheet>
    <worksheet name="Churners reached by contact capacity">
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize="12" fontcolor="#162b40" bold="true">Churners reached by contact capacity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="capacity_metrics" caption="Held-out evaluation • contact capacity" />
          </datasources>
          <datasource-dependencies datasource="capacity_metrics">
            <column datatype="real" name="[recall]" role="measure" type="quantitative" caption="Share of churners found" default-format="p0.0%" />
            <column datatype="real" name="[contact_share]" role="measure" type="quantitative" caption="Share of customers contacted" default-format="p0.0%" />
            <column-instance column="[recall]" derivation="Avg" name="[avg:recall:qk]" pivot="key" type="quantitative" />
            <column-instance column="[contact_share]" derivation="Avg" name="[avg:contact_share:qk]" pivot="key" type="quantitative" />
            <column-instance column="[contact_share]" derivation="None" name="[none:contact_share:ok]" pivot="key" type="ordinal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="font-size" value="10" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <lod column="[capacity_metrics].[none:contact_share:ok]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#2a78d6" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[capacity_metrics].[avg:recall:qk]</rows>
        <cols>[capacity_metrics].[avg:contact_share:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Precision at each contact capacity">
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize="12" fontcolor="#162b40" bold="true">Precision at each contact capacity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="capacity_metrics" caption="Held-out evaluation • contact capacity" />
          </datasources>
          <datasource-dependencies datasource="capacity_metrics">
            <column datatype="real" name="[precision]" role="measure" type="quantitative" caption="Churn rate in contacted group" default-format="p0.0%" />
            <column datatype="real" name="[contact_share]" role="measure" type="quantitative" caption="Share of customers contacted" default-format="p0.0%" />
            <column-instance column="[precision]" derivation="Avg" name="[avg:precision:qk]" pivot="key" type="quantitative" />
            <column-instance column="[contact_share]" derivation="Avg" name="[avg:contact_share:qk]" pivot="key" type="quantitative" />
            <column-instance column="[contact_share]" derivation="None" name="[none:contact_share:ok]" pivot="key" type="ordinal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="font-size" value="10" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <lod column="[capacity_metrics].[none:contact_share:ok]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#2a78d6" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[capacity_metrics].[avg:precision:qk]</rows>
        <cols>[capacity_metrics].[avg:contact_share:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Calibration on unseen customers">
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize="12" fontcolor="#162b40" bold="true">Calibration on unseen customers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="calibration" caption="Held-out evaluation • score calibration" />
          </datasources>
          <datasource-dependencies datasource="calibration">
            <column datatype="real" name="[observed_churn_rate]" role="measure" type="quantitative" caption="Observed churn rate" default-format="p0.0%" />
            <column datatype="real" name="[mean_probability]" role="measure" type="quantitative" caption="Mean predicted score" default-format="p0.0%" />
            <column-instance column="[observed_churn_rate]" derivation="Avg" name="[avg:observed_churn_rate:qk]" pivot="key" type="quantitative" />
            <column-instance column="[mean_probability]" derivation="Avg" name="[avg:mean_probability:qk]" pivot="key" type="quantitative" />
            <column-instance column="[mean_probability]" derivation="None" name="[none:mean_probability:ok]" pivot="key" type="ordinal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="font-size" value="10" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <lod column="[calibration].[none:mean_probability:ok]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#2a78d6" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[calibration].[avg:observed_churn_rate:qk]</rows>
        <cols>[calibration].[avg:mean_probability:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Overview">
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <size maxheight="900" maxwidth="1300" minheight="900" minwidth="1300" />
      <zones>
        <zone id="0" type-v2="layout-basic" x="0" y="0" w="100000" h="100000">
          <zone id="1" x="1800" y="1800" w="96400" h="4600" type-v2="text">
            <formatted-text>
              <run fontsize="22" fontcolor="#162b40">CHURN INTELLIGENCE  /  OVERVIEW</run>
            </formatted-text>
          </zone>
          <zone id="2" x="1800" y="6800" w="96400" h="5000" type-v2="text">
            <formatted-text>
              <run fontsize="10" fontcolor="#566579">Full snapshot: 7,043 customers • 1,869 churned • descriptive views include the 11 zero-tenure customers.</run>
            </formatted-text>
          </zone>
          <zone id="3" x="1800" y="13000" w="30000" h="13000" name="All customers">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="4" x="34000" y="13000" w="30000" h="13000" name="Observed churn">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="5" x="66200" y="13000" w="32000" h="13000" name="Monthly billing">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="6" x="1800" y="29000" w="46000" h="30000" name="Churn by contract">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="7" x="50000" y="29000" w="48200" h="30000" name="Churn by internet service">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="8" x="1800" y="62000" w="96400" h="30000" name="Churn by payment method">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="9" x="1800" y="94500" w="96400" h="5000" type-v2="text">
            <formatted-text>
              <run fontsize="10" fontcolor="#566579">Associations describe this snapshot; they do not show why customers left or whether an offer would retain them.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
    </dashboard>
    <dashboard name="Model performance">
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <size maxheight="900" maxwidth="1300" minheight="900" minwidth="1300" />
      <zones>
        <zone id="0" type-v2="layout-basic" x="0" y="0" w="100000" h="100000">
          <zone id="1" x="1800" y="1800" w="96400" h="4600" type-v2="text">
            <formatted-text>
              <run fontsize="22" fontcolor="#162b40">CHURN INTELLIGENCE  /  MODEL PERFORMANCE</run>
            </formatted-text>
          </zone>
          <zone id="2" x="1800" y="6800" w="96400" h="5000" type-v2="text">
            <formatted-text>
              <run fontsize="10" fontcolor="#566579">Held-out customers: 1,758 • ROC-AUC 0.839 • average precision 0.623 • Brier score 0.139</run>
            </formatted-text>
          </zone>
          <zone id="3" x="1800" y="15000" w="46000" h="35000" name="Churners reached by contact capacity">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="4" x="50000" y="15000" w="48200" h="35000" name="Precision at each contact capacity">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="5" x="1800" y="53000" w="96400" h="39000" name="Calibration on unseen customers">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="6" x="1800" y="94500" w="96400" h="5000" type-v2="text">
            <formatted-text>
              <run fontsize="10" fontcolor="#566579">Threshold 0.31871380 selected on training OOF F1. Similar CV/test performance; no future-month validation.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
    </dashboard>
    <dashboard name="Customer priorities">
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <size maxheight="900" maxwidth="1300" minheight="900" minwidth="1300" />
      <zones>
        <zone id="0" type-v2="layout-basic" x="0" y="0" w="100000" h="100000">
          <zone id="1" x="1800" y="1800" w="96400" h="4600" type-v2="text">
            <formatted-text>
              <run fontsize="22" fontcolor="#162b40">CHURN INTELLIGENCE  /  CUSTOMER PRIORITIES</run>
            </formatted-text>
          </zone>
          <zone id="2" x="1800" y="6800" w="96400" h="5000" type-v2="text">
            <formatted-text>
              <run fontsize="10" fontcolor="#566579">Retrospective OOF scores • 5,163 eligible current customers • 11 zero-tenure customers excluded • table filters apply only to the contact table.</run>
            </formatted-text>
          </zone>
          <zone id="3" x="1800" y="13000" w="46000" h="22000" name="Customers by priority bucket">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="4" x="50000" y="13000" w="48200" h="22000" name="Score × monthly bill by bucket">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="5" x="1800" y="37000" w="96400" h="21000" name="Risk and monthly bill">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="6" x="1800" y="68000" w="96400" h="25000" name="Ranked contact table">
            <zone-style>
              <format attr="margin" value="10" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="7" x="1800" y="60000" w="30000" h="7000" type-v2="filter" name="Ranked contact table" param="[priority_list].[none:bucket:nk]" mode="checkdropdown" />
          <zone id="8" x="34000" y="60000" w="30000" h="7000" type-v2="filter" name="Ranked contact table" param="[priority_list].[none:Contract:nk]" mode="checkdropdown" />
          <zone id="9" x="66200" y="60000" w="30000" h="7000" type-v2="filter" name="Ranked contact table" param="[priority_list].[none:InternetService:nk]" mode="checkdropdown" />
          <zone id="10" x="1800" y="94500" w="96400" h="5000" type-v2="text">
            <formatted-text>
              <run fontsize="10" fontcolor="#566579">Cutoffs: score ≥ 0.31871380; bill ≥ $64.45. Score × bill is a ranking measure, not losses or savings.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
